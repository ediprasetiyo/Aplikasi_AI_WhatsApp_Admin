# ==== Worker config ====
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
WORKER_ID=worker-1

# DB (sama dengan web — pakai Neon)
DATABASE_URL=postgresql://...

# Auth Bearer token antara web ↔ worker (generate random 32+ char)
WORKER_AUTH_SECRET=change-me-to-random-secret

# Origin web yang boleh akses worker (CORS), comma-separated
WEB_ORIGIN=https://autobalas.vercel.app

# URL web untuk trigger AI reply saat ada pesan masuk
WEB_URL=https://autobalas.vercel.app
INTERNAL_WEBHOOK_SECRET=change-me-to-another-random-secret
