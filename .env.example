# ===== Database =====
DATABASE_URL="postgresql://wa_admin:wa_admin@localhost:5433/wa_admin?schema=public"

# ===== Redis =====
REDIS_URL="redis://localhost:6379"

# ===== Auth =====
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-string"
BETTER_AUTH_URL="http://localhost:3000"

# ===== Web (Next.js) =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ===== API (NestJS) =====
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"

# ===== AI: Groq (free) =====
# Get key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ===== WhatsApp Cloud API =====
# Setup at https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"
WHATSAPP_APP_SECRET=""
# Per-tenant credentials (phone_number_id, access_token) stored in DB later

# ===== Baileys Worker (VPS terpisah) =====
# URL worker yang jalan di VPS — kosongkan untuk dev tanpa Baileys
WORKER_URL=""
# Bearer secret antara web ↔ worker (harus sama persis dengan .env di worker)
WORKER_AUTH_SECRET=""
# Bearer secret antara worker ↔ web internal API (untuk trigger AI reply)
INTERNAL_WEBHOOK_SECRET=""
